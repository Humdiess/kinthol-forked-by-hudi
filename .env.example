# ETHOL PENS SSO Credentials
ETHOL_EMAIL=email@student.pens.ac.id
ETHOL_PASSWORD=sso_password

# Optional: Telegram Notifications (leave empty to disable)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Forum supergroup topic thread IDs (leave empty to use general chat)
TELEGRAM_COMMAND_THREAD_ID=
TELEGRAM_NOTIF_THREAD_ID=
# Comma-separated Telegram user IDs allowed to run commands. Required for group chats.
TELEGRAM_ALLOWED_USER_IDS=

# Optional: Auto-Presence (set to "true" or "1" to enable; disabled by default)
ETHOL_AUTO_PRESENCE=
# Optional local health endpoint, e.g. 127.0.0.1:8080
ETHOL_HEALTH_ADDR=

# Optional: Multi-tenant service mode (enable with --service)
# ETHOL_SERVICE_ADDR=:8090
# ETHOL_SERVICE_STATE_PATH=ethold_service_state.json
# ETHOL_SERVICE_ADMIN_TOKEN=replace-with-long-random-token
# ETHOL_SERVICE_ENCRYPTION_KEY=replace-with-long-random-key
# ETHOL_SERVICE_BASE_URL=https://ethol.pens.ac.id
# ETHOL_SERVICE_WORKER_CONCURRENCY=4
